# Tilawah Audio & API Configuration
# Primary Free Quran Audio Sources (No API keys required):
#   - Source A: Al Quran Cloud / Islamic Network CDN (https://api.alquran.cloud/v1 & https://cdn.islamic.network)
#   - Source B: EveryAyah Recitation Library (https://everyayah.com/data/)
#   - Source C: Public Quran.com API v4 (https://api.quran.com/api/v4/)
#
# Optional Backend Proxy URL for Authenticated Quran Foundation OAuth2 Access:
# Keep client_id / client_secret strictly on your server-side proxy; NEVER bundle private client secrets in client APKs.
QURAN_FOUNDATION_PROXY_URL=MY_QURAN_FOUNDATION_PROXY_URL
